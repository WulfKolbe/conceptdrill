{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conceptdrill:kb/1/kb.json",
  "title": "kb/1 kb.json: every node of a knowledge base, with its sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kb",
    "documents",
    "sections",
    "payload",
    "topics",
    "leaves",
    "concepts",
    "terms"
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "section_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*#[0-9]+$"
    },
    "payload_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*#[^#\\s]+$"
    },
    "leaf_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "properties": {
    "format": {
      "const": "kb/1"
    },
    "kb": {
      "$ref": "#/$defs/slug"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc",
          "folder",
          "title",
          "glyphs",
          "docmodel"
        ],
        "properties": {
          "doc": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string"
          },
          "glyphs": {
            "$ref": "#/$defs/input"
          },
          "docmodel": {
            "oneOf": [
              {
                "$ref": "#/$defs/input"
              },
              {
                "type": "null"
              }
            ]
          },
          "folder": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "doc",
          "order",
          "title",
          "number",
          "page",
          "line_start",
          "line_end",
          "status",
          "cited_by",
          "reason",
          "text_file",
          "text_sha256",
          "words",
          "nul"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/section_id"
          },
          "doc": {
            "$ref": "#/$defs/slug"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "number": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "cited",
              "unused"
            ]
          },
          "cited_by": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/leaf_id"
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "text_file": {
            "type": "string",
            "pattern": "^text/[a-z0-9]+(-[a-z0-9]+)*/[0-9]+\\.txt$"
          },
          "text_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "words": {
            "type": "integer",
            "minimum": 0
          },
          "nul": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "payload": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "doc",
          "kind",
          "members",
          "field",
          "section",
          "placed_by",
          "status",
          "labels",
          "file",
          "sha256",
          "reason"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/payload_id"
          },
          "doc": {
            "$ref": "#/$defs/slug"
          },
          "kind": {
            "enum": [
              "equation",
              "code",
              "pseudocode"
            ]
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "field": {
            "type": "string"
          },
          "section": {
            "oneOf": [
              {
                "$ref": "#/$defs/section_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "placed_by": {
            "enum": [
              "text",
              "page",
              null
            ]
          },
          "status": {
            "enum": [
              "placed",
              "unplaced"
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "enum": [
                "verified",
                "unverified",
                "line numbers not separated",
                "detected pseudocode"
              ]
            }
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "folder",
          "leaves"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "folder": {
            "type": "string",
            "pattern": "^topics/[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "leaves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/leaf_id"
            }
          }
        }
      }
    },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "topic",
          "path",
          "concepts",
          "sources",
          "payload",
          "related"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/leaf_id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "$ref": "#/$defs/slug"
          },
          "path": {
            "type": "string"
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/section_id"
            }
          },
          "payload": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/payload_id"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/leaf_id"
            }
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "leaf"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "leaf": {
            "$ref": "#/$defs/leaf_id"
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "definition",
          "leaf"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string"
          },
          "leaf": {
            "$ref": "#/$defs/leaf_id"
          }
        }
      }
    }
  }
}
